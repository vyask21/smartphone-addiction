# Competition data is never committed — licence terms usually forbid
# redistribution, and it bloats the repo a reader came to read.
data/
artifacts/
submissions/*.csv
__pycache__/
*.pyc
.ipynb_checkpoints/
.venv/

# Local working log. Deliberately not committed: it records the session as it
# happened, including dead ends and machine-specific detail, which belongs in a
# private log rather than in the artifact a reader came to read. The conclusions
# that matter are promoted into NOTES.md.
SESSION.md

# Smoke-test scratch from 10_neural_kaggle.ipynb. The notebook prefixes its outputs
# when SMOKE is on so they can never be mistaken for real artifacts; this keeps them
# out of the repo as well.
SMOKE_*
notebooks/_smoke*.ipynb
neural_oof.npy
neural_test.npy
submission.csv

# Staged copy of the notebook that `kaggle kernels push` uploads. set_smoke.py and
# stage.py recreate it from notebooks/ on every run, so committing it would just be a
# second copy of the same file drifting out of date.
kaggle/*/10_neural_kaggle.ipynb
kaggle/*/12_public_writeup.ipynb
kaggle/*/13_target_encoding.ipynb
kaggle/*/out/
kaggle/*/out_*/
kaggle/*/14_features_v2.ipynb
kaggle/*/15_te_seeds.ipynb
kaggle/*/17_catboost_te.ipynb
kaggle/*/19_catboost_seeds.ipynb
kaggle/*/20_stack_23.ipynb
kaggle/*/21_neural_te.ipynb
kaggle/*/23_lgbm_leaves.ipynb
kaggle/*/24_xgboost_te.ipynb
kaggle/*/25_xgb_seeds.ipynb
